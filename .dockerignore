# Dépendances locales
# `venv/` autant que `.venv/` : le venv de dev est versionné dans ce repo, donc
# sans cette ligne il partait dans le contexte de build ET dans l'image — des
# centaines de Mo de dépendances macOS recopiées à chaque deploy.
venv/
.venv/
node_modules/

# Fichiers générés (recréés dans le container)
staticfiles/
static/react/

# Secrets — ne jamais copier dans l'image
.env
.env.*
!.env.production.example

# Uploads utilisateurs (gérés via volume Docker)
media/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
coverage.xml
coverage.json
htmlcov/

# Git
.git/
.github/

# Sessions et worktrees de l'assistant. `.claude/worktrees/` contient des COPIES
# COMPLÈTES du dépôt : sans cette ligne, le contexte de build enfle d'un dépôt
# entier par branche en cours, et l'image publiée emporterait des branches non
# fusionnées de l'auteur chez tous ceux qui l'installent.
.claude/

# Tests E2E
playwright-report/
test-results/

# IDE
.vscode/
.idea/
