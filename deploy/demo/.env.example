# Instance de démonstration — à copier en `.env` sur le VPS.
#
# Rien ici n'est un secret au sens habituel : le foyer est fictif, les données
# sont fausses, et la base est détruite chaque nuit. Les deux vraies valeurs
# sensibles sont la clé Anthropic (elle coûte de l'argent) et le mot de passe
# Postgres (il protège un conteneur, pas des données).

DOMAIN=demo.maisonnee.jammin-dev.com
STACK_NAME=maisonneedemo
MAISONNEE_IMAGE=ghcr.io/jammindev/maisonnee:latest

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=à-générer-avec-openssl-rand-base64-50
ALLOWED_HOSTS=demo.maisonnee.jammin-dev.com
CORS_ALLOWED_ORIGINS=https://demo.maisonnee.jammin-dev.com
FRONTEND_URL=https://demo.maisonnee.jammin-dev.com

POSTGRES_DB=maisonnee_demo
POSTGRES_USER=maisonnee
POSTGRES_PASSWORD=à-générer
DATABASE_URL=postgres://maisonnee:à-générer@db:5432/maisonnee_demo

# ── Ce qui fait de cette instance une démonstration ──────────────────────────
#
# Les trois doivent être posés : une moitié de configuration vaut indisponible,
# et l'écran de connexion n'affichera alors rien du tout.
DEMO_MODE=1
DEMO_EMAIL=claire.mercier@demo.local
DEMO_PASSWORD=demo1234

# ⚠️ Fermée, sans exception. Un visiteur qui crée un compte atterrit dans un
# foyer **vide** — soit exactement l'inverse de ce que la vitrine existe pour
# montrer, et la meilleure façon de le faire repartir.
ALLOW_OPEN_SIGNUP=False

# ── L'assistant ──────────────────────────────────────────────────────────────
#
# C'est l'argument de vente du produit, donc il tourne. Il tourne sur cette
# clé-ci, donc chaque question est payée par l'hébergeur : `DEMO_MODE` serre
# automatiquement les débits (voir `config/settings/production.py`), et les deux
# variables ci-dessous permettent d'ajuster sans redéployer une image.
#
# ⚠️ Poser AUSSI un plafond de dépense dans la console du fournisseur. Un
# compteur applicatif ne protège que de ce qu'il voit passer.
ANTHROPIC_API_KEY=
DEMO_AGENT_BURST=5/min
DEMO_AGENT_SUSTAINED=60/hour

# La recherche sémantique — facultative. Sans elle la palette garde sa jambe
# lexicale, qui répond seule et instantanément.
VOYAGE_API_KEY=

# Rien à envoyer depuis une démonstration : pas d'e-mail, pas de push, pas de
# Telegram. Les capacités correspondantes s'annoncent indisponibles, ce qui est
# la vérité et ce que l'app sait déjà dire proprement.
